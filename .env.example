APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Serve the site over HTTPS in production. Set to false when developing
# over plain http://localhost, otherwise the session cookie is dropped.
SESSION_SECURE_COOKIE=true

# Comma-separated proxy IPs (or *) whose X-Forwarded-* headers to trust.
# Leave empty when no reverse proxy sits in front of the app.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payments ------------------------------------------------------------------
# Which gateway the store uses by default. "cod" = cash on delivery only.
PAYMENTS_DRIVER=cod

# Flutterwave (https://developer.flutterwave.com). Leave the keys empty
# until you have created an account and obtained live credentials; the
# store stays cash-on-delivery only until they are filled in and
# PAYMENTS_DRIVER is set to "flutterwave".
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
# Secret hash you set when registering the webhook URL; used to verify
# that webhook deliveries really come from Flutterwave.
FLW_SECRET_HASH=
# Currencies the hosted checkout may charge in, comma separated. Include
# the currency chosen in the admin settings, otherwise only cash on
# delivery is offered at checkout.
FLW_CURRENCIES=USD,UGX
